# =============================================
# Vertext Devices — Environment Variables
# Fill in your values, then add ALL to Netlify
# =============================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- CellGods Reseller API ---
CELLGODS_API_KEY=cg_reseller_YOUR_KEY_HERE

# --- Paystack (KES account) ---
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public

# --- NOWPayments (Crypto USDT) ---
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# --- App ---
VITE_APP_URL=https://vertext.site
ADMIN_EMAIL=sammyseth260@gmail.com

# =============================================
# HOW TO ADD TO NETLIFY:
# Netlify Dashboard → Your Site → Site Settings
# → Environment Variables → Add each key above
# =============================================
# IMPORTANT NOTES:
# - VITE_* vars are exposed to browser (safe: only public keys)
# - Other vars are server-only (Netlify Functions)
# - PAYSTACK deposits are charged in KES (Kenya Shillings)
#   Wallet balances are stored and shown in USD
#   Default exchange rate: 1 USD = 130 KES (configurable in admin_settings)
# - NOWPayments webhooks: set IPN URL in NOWPayments dashboard to:
#   https://vertext.site/.netlify/functions/nowpay-webhook
# - Paystack webhooks: set in Paystack dashboard to:
#   https://vertext.site/.netlify/functions/paystack-webhook
# =============================================
